{
  "experiment_name": "fm_smoke",
  "output_root": "outputs",
  "policy_config": null,
  "dataset": {
    "root": "data/block_insertion_real_combined_v30_advantage",
    "val_fraction": 0.1,
    "split_seed": 42,
    "stratify_key": "tasks",
    "max_train_samples": 12,
    "max_val_samples": 4
  },
  "training": {
    "seed": 42,
    "num_epochs": 2,
    "batch_size": 2,
    "num_workers": 0,
    "gradient_accumulation_steps": 2,
    "gradient_clip_norm": 1.0,
    "device": "cpu",
    "max_updates": 3,
    "objective": "fm",
    "num_steps": null
  },
  "optimizer": {
    "learning_rate": 0.0001,
    "backbone_learning_rate": 1e-05,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "warmup_steps": 0,
    "min_lr_ratio": 0.01
  },
  "amp": {
    "enabled": true,
    "dtype": "bfloat16"
  },
  "ema": {
    "enabled": true,
    "decay": 0.999
  },
  "validation": {
    "interval": 1,
    "batch_size": 2,
    "seed": 1234,
    "use_ema": true
  },
  "checkpoint": {
    "save_interval": 1,
    "keep_last_n": 3
  },
  "logging": {
    "use_wandb": false,
    "log_interval": 1,
    "progress_bar": true
  }
}
